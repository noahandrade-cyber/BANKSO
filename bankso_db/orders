CREATE TABLE orders (

id INT AUTO_INCREMENT PRIMARY KEY,

user_id INT,

address_id INT,

total DECIMAL(10,2),

status ENUM(

'En attente',

'Payée',

'Expédiée',

'Livrée',

'Annulée'

),

created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

FOREIGN KEY(user_id)

REFERENCES users(id),

FOREIGN KEY(address_id)

REFERENCES addresses(id)

);